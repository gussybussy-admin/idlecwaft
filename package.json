{
  "name": "idlecwaft",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "assets": "tsx packages/assets/src/cli.ts",
    "viewer": "npm run dev -w @idle/viewer",
    "game": "npm run dev -w @idle/game",
    "server": "npm start -w @idle/server",
    "launcher": "npm run dev -w @idle/launcher",
    "build:launcher": "npm run build -w @idle/launcher",
    "test": "vitest run",
    "typecheck": "tsc -p packages/sim && tsc -p packages/assets && tsc -p apps/viewer && tsc -p apps/game && tsc -p apps/server && tsc -p apps/launcher"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
