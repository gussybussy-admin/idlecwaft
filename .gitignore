node_modules/
dist/
*.tsbuildinfo

# Local config: points at your own WoW client. Never commit.
idle.config.json

# Everything extracted or converted from the Blizzard client lives here. Never commit.
cache/

# VMaNGOS world database (imported locally at runtime). Never commit.
data/vmangos/

# Launcher: per-player settings and converted art (from running it from source or next to the exe).
launcher-data/
idlecraft-cache/
idlecraft-launcher.json

# Game server database (accounts, characters, guild) and local server config.
data/server/
server.config.json

# Belt and braces: raw client formats must never enter the repo, wherever they land.
*.mpq
*.MPQ
*.dbc
*.blp
*.m2
*.mdx
*.wmo
*.adt
*.wdt
*.wdl
*.skin
*.glb
*.gltf

# Converted asset outputs (should only ever be under cache/, but just in case)
**/public/assets/

# launcher swaps (self-update and rebuilds while running)
*.exe.old
*.exe.download

# The launcher build: friends get it from the guild server (/api/launcher), not from git.
release/IdlecraftLauncher.exe
